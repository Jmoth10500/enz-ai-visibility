# Evolution NetZero AI Visibility — optional connected sources
#
# The core audit works with ZERO of these set. Each one is additive: connect
# it and the corresponding evidence group in the dashboard fills in; leave it
# unset and that section shows "not connected" rather than fake data.
#
# Copy this file to .env and fill in only what you actually connect.
# NEVER commit the real .env file — it's already in .gitignore.

# --- Google Search Console (optional) ---
# Free. Shows real conventional-search evidence for evolutionnetzero.com:
# queries, impressions, clicks, average position. Separate evidence group
# from the AI-visibility audit — never blended into the independent score.
GSC_SITE_URL=
GSC_SERVICE_ACCOUNT_JSON=   # path to a service-account key file, or paste inline JSON

# --- GA4 Data API (optional) ---
# Free. Shows real traffic/behaviour evidence, again kept in its own
# evidence group, never mixed into the AI-visibility score.
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# --- Bing Webmaster Tools (optional) ---
# Free tier. Adds Bing's own search evidence alongside GSC.
BING_WEBMASTER_API_KEY=

# --- GitHub (used by the Action to commit evidence/metrics back to the repo) ---
# Set automatically by GitHub Actions — you do not need to fill this in
# yourself unless running collect_free_sources.py + score.py locally and
# wanting them committed too.
# GITHUB_TOKEN is provided by Actions automatically; nothing to add here.
